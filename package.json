{
  "name": "opencode-memos",
  "version": "0.1.0",
  "description": "Browse and manage grouped personal memos in the OpenCode TUI sidebar",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    "./tui": "./dist/tui.js"
  },
  "files": ["src", "dist", "tsconfig.json"],
  "keywords": ["opencode", "memos", "tui"],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build:tui": "BUN_BE_BUN=1 opencode scripts/build.ts",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build:tui"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.2.5 <3",
    "@opentui/core": ">=0.8.0 <0.9",
    "@opentui/solid": ">=0.8.0 <0.9",
    "solid-js": ">=1.9.0 <2"
  },
  "devDependencies": {
    "@opencode/plugin": "2.2.5",
    "@opentui/core": "0.8.0",
    "@opentui/solid": "0.8.0",
    "@types/node": "^24.0.0",
    "solid-js": "1.9.17",
    "typescript": "5.9.3"
  }
}
